---
import Container from "@layouts/Container.astro";
import Logo from "@components/shared/Logo.astro";

import Address from "@components/footer/Address.astro";
import Company from "@components/footer/Company.astro";
import Attribution from "@components/footer/Attribution.astro";
---

<footer class="bg-charcoal py-12 text-white border-t border-neutral-500">
  <Container className="grid gap-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:justify-between">
      <div class="grid gap-4">
        <Logo />

        <h2>Sulery Ventures</h2>

        <p class="max-w-[30ch]">
          Delivering precise, secure, and reliable technology solutions to
          enterprise clients and individuals across Lagos.
        </p>
      </div>

      <div>
        <h3>Services</h3>

        <ul class="grid gap-2 mt-6">
          <li>Service 1</li>
          <li>Service 1</li>
          <li>Service 1</li>
          <li>Service 1</li>
          <li>Service 1</li>
          <li>Service 1</li>
          <li>Service 1</li>
        </ul>
      </div>

      <Company />

      <Address />
    </div>

    <hr />

    <Attribution />
  </Container>
</footer>
