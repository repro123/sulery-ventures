---
import Container from "@layouts/Container.astro";

import Address from "@components/footer/Address.astro";
import Company from "@components/footer/Company.astro";
import Attribution from "@components/footer/Attribution.astro";
import FooterServices from "@components/footer/FooterServices.astro";

import LogoWhite from "@assets/logos/logo-white.png";
import { Image } from "astro:assets";

import { getCollection } from "astro:content";

const services = await getCollection("services");

const sortedServices = services
  .sort((a, b) => a.data.order - b.data.order)
  .map((service) => ({
    id: service.id,
    title: service.data.title,
  }));
---

<footer class="bg-charcoal py-12 text-white border-t border-neutral-500">
  <Container className="grid gap-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:justify-between">
      <div class="space-y-4">
        <Image src={LogoWhite} alt="Sulery Ventures" class="w-full max-w-60" />

        <h2>Sulery Ventures</h2>

        <p class="max-w-[30ch]">
          Delivering precise, secure, and reliable technology solutions to
          enterprise clients and individuals across Lagos.
        </p>
      </div>

      <FooterServices services={sortedServices} />

      <Company />

      <Address />
    </div>

    <hr />

    <Attribution />
  </Container>
</footer>
