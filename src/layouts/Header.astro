---
import Container from "@layouts/Container.astro";
import MobileMenu from "@components/client/MobileMenu.tsx";
import Navigation from "@components/shared/Navigation.astro";

import HeaderCallCTA from "@components/header/HeaderCallCTA.astro";

import IconBlack from "@assets/logos/icon-black.png";
import { Image } from "astro:assets";
---

<header class="sticky top-0 z-50 bg-white/80 py-4 shadow backdrop-blur-sm">
  <Container className="flex items-center gap-4 justify-between">
    <a href="/" aria-label="Sulery Ventures Home">
      <Image
        src={IconBlack}
        alt="Sulery Ventures"
        class="w-20 h-12"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <MobileMenu client:load />

    <div class="hidden lg:block">
      <Navigation
        ulClass="font-sora tracking-wider flex items-center gap-6 xl:gap-12 uppercase font-semibold"
        liClass="hover:text-primary-orange"
        activeClass="desktop-active"
      />
    </div>

    <HeaderCallCTA />
  </Container>
</header>
