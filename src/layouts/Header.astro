---
import Container from "@layouts/Container.astro";
import MobileMenu from "@components/client/MobileMenu.tsx";
import HeaderNavigationMenu from "@/components/client/NavigationMenu";

import HeaderCallCTA from "@components/header/HeaderCallCTA.astro";

import IconBlack from "@assets/logos/icon-black.png";
import { Image } from "astro:assets";

import { getCollection } from "astro:content";

const services = await getCollection("services");

const sortedServices = services
  .sort((a, b) => a.data.order - b.data.order)
  .map((service) => ({
    id: service.id,
    title: service.data.title,
    description: service.data.description,
  }));
---

<header class="sticky top-0 z-50 bg-white/80 py-4 shadow backdrop-blur-sm">
  <Container className="flex items-center gap-4 justify-between">
    <a href="/" aria-label="Sulery Ventures Home">
      <Image
        src={IconBlack}
        alt="Sulery Ventures"
        class="w-20 h-12"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <MobileMenu services={sortedServices} client:load />

    <div class="hidden lg:block">
      <HeaderNavigationMenu services={sortedServices} client:load />
    </div>

    <HeaderCallCTA />
  </Container>
</header>
