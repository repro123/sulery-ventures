---
import Whatsapp from "@components/svg/Whatsapp.astro";
import { MapPin, Phone, Mail } from "@lucide/astro";
---

<div>
  <h3>Contact information</h3>

  <ul class="mt-6 grid gap-4">
    <li
      class="bg-light-accent p-4 border border-primary-orange hover:bg-primary-orange hover:text-white focus-within:bg-primary-orange focus-within:text-white"
    >
      <a
        href="tel:+2348023220365"
        class="flex items-center gap-4 border-0 outline-0"
      >
        <Phone />
        <span class="flex flex-col gap-1">
          <span class="font-semibold">Phone</span>
          <span>+234-(0)-8023220364</span>
        </span></a
      >
    </li>

    <li
      class="bg-light-accent p-4 border border-primary-orange hover:bg-primary-orange hover:text-white focus-within:bg-primary-orange focus-within:text-white"
    >
      <a
        href="mailto:bellosulea@gmail.com"
        class="flex items-center gap-4 border-0 outline-0"
      >
        <Mail />
        <span class="flex flex-col gap-1">
          <span class="font-semibold">Mail</span>
          <span>bellosulea@gmail.com</span>
        </span></a
      >
    </li>

    <li
      class="bg-light-accent p-4 border border-primary-orange hover:bg-primary-orange hover:text-white focus-within:bg-primary-orange focus-within:text-white"
    >
      <a
        href="https://wa.me/2348023220365"
        target="_blank"
        class="flex items-center gap-4 border-0 outline-0"
      >
        <Whatsapp className="size-6" />
        <span class="flex flex-col gap-1">
          <span class="font-semibold">WhatsApp</span>
          <span>08023220365</span>
        </span></a
      >
    </li>

    <li
      class="flex items-center gap-4 p-4 border border-muted-text bg-muted-text/10"
    >
      <MapPin />
      <span class="flex flex-col gap-1">
        <span class="font-semibold">Location</span>
        <p>Lagos, Nigeria</p>
      </span>
    </li>
  </ul>
</div>
