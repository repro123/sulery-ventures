---
import Whatsapp from "@components/svg/Whatsapp.astro";
import { MapPin, Phone, Mail } from "@lucide/astro";
---

<div>
  <h3>Get in touch</h3>

  <address class="grid gap-4 mt-6">
    <div class="flex items-center gap-2">
      <MapPin />
      <p>Lagos, Nigeria</p>
    </div>
    <div class="flex items-start gap-2">
      <Phone />
      <div class="flex flex-col gap-1">
        <a href="tel:+2348023220365" class="text-light-accent hover:underline"
          >+234-(0)-8023220365</a
        >
        <a href="tel:+2348098235567" class="text-light-accent hover:underline"
          >+234-(0)-8098235567</a
        >
      </div>
    </div>
    <div class="flex items-center gap-2">
      <Mail />
      <a
        href="mailto:suleryventures@hotmail.com"
        class="text-light-accent hover:underline">suleryventures@hotmail.com</a
      >
    </div>
    <div class="flex items-center gap-2">
      <Whatsapp className="size-6" />
      <a
        href="https://wa.me/2348023220365"
        target="_blank"
        class="text-light-accent hover:underline">08023220365</a
      >
    </div>
  </address>
</div>
