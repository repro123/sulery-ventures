---
interface Props {
  services: {
    id: string;
    title: string;
  }[];
}

const { services } = Astro.props;
---

<div>
  <h3>Services</h3>

  <ul class="grid gap-2 mt-6">
    {
      services.map((service) => (
        <li class="text-light-accent capitalize">
          <a href={`/services/${service.id}`} class="hover:underline">
            {service.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
