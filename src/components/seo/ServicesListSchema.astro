---
import type { CollectionEntry } from "astro:content";
import {
  businessLocations,
  businessName,
  businessPhoneNumbers,
  parentBusinessName,
  siteUrl,
} from "@/lib/schema";

interface Props {
  services: CollectionEntry<"services">[];
}

const { services } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",

  name: "Sulery Computer Technologies Services",

  description:
    "Computer, office equipment, printing, networking, security, CBT deployment, access control, intercom and website design services provided by Sulery Computer Technologies in Apapa, Surulere and Ikorodu, Lagos, Nigeria.",

  numberOfItems: services.length,

  itemListElement: services.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Service",
      name: service.data.title,
      description: service.data.description,
      url: new URL(`/services/${service.id}`, siteUrl).toString(),
      areaServed: businessLocations,
      provider: {
        "@type": "LocalBusiness",
        name: businessName,
        alternateName: parentBusinessName,
        telephone: businessPhoneNumbers,
        url: siteUrl,
      },
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
