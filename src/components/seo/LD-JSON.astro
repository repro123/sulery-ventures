---
import { getCollection } from "astro:content";
import {
  businessEmail,
  businessLocations,
  businessName,
  businessPhoneNumbers,
  coreServices,
  parentBusinessName,
  siteUrl,
} from "@/lib/schema";

const services = await getCollection("services");
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);
const serviceNames = sortedServices.map((service) => service.data.title);

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",

  name: businessName,
  alternateName: parentBusinessName,
  email: businessEmail,

  url: siteUrl,

  description:
    "Sulery Computer Technologies, a subsidiary of Sulery Ventures, provides computer sales, supply, repair and maintenance, office equipment, networking, internet connectivity, printing, cybercafe installation, WAEC and NECO CBT deployment, CCTV, intercom, access control and website design services in Lagos, Nigeria.",

  telephone: businessPhoneNumbers,

  areaServed: businessLocations,

  knowsAbout: [...new Set([...serviceNames, ...coreServices])],

  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Sulery Computer Technologies services",
    itemListElement: sortedServices.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.data.title,
        description: service.data.description,
        url: new URL(`/services/${service.id}`, siteUrl).toString(),
        areaServed: businessLocations,
      },
    })),
  },

  contactPoint: businessPhoneNumbers.map((telephone) => ({
    "@type": "ContactPoint",
    telephone,
    contactType: "customer service",
    areaServed: "NG",
    availableLanguage: "English",
  })),
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
  is:inline
/>
