---
import Hero from "@components/shared/Hero.astro";
import { services as servicesArray } from "@lib/data.ts";
import type { CollectionEntry } from "astro:content";

interface Props {
  service: CollectionEntry<"services">;
}

const { service } = Astro.props;
const selectedService = servicesArray.find(
  (item) => item.label.toLowerCase().replaceAll(" ", "-") === service.id,
);

if (!selectedService) {
  throw new Error(
    `No matching service found in servicesArray for slug: ${service.id}`,
  );
}
---

<Hero
  imgSrc={selectedService.image}
  eyebrowText={service.data.title}
  headingSpanOne={service.data.priSpan}
  headingSpanTwo={service.data.secSpan}
  descriptionText={service.data.description}
  ctas={[
    { label: "Services", href: "/services", variant: "primary" },
    {
      label: "Message Us",
      href: "https://wa.me/2348023220365",
      variant: "secondary",
      external: true,
    },
  ]}
/>
