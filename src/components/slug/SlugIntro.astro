---
import Container from "@layouts/Container.astro";
import HorizontalBar from "@components/shared/HorizontalBar.astro";

interface Props {
  heading: string;
  paragraphs: string[];
}

const { heading, paragraphs } = Astro.props;
---

<section class="py-12">
  <Container>
    <h2>{heading}</h2>
    <HorizontalBar />

    <div class="max-w-prose grid gap-4 mt-6">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </Container>
</section>
