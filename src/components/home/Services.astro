---
import Container from "@layouts/Container.astro";
import HorizontalBar from "@components/shared/HorizontalBar.astro";
import type { CollectionEntry } from "astro:content";

import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";

interface Props {
  services: CollectionEntry<"services">[];
}

const { services } = Astro.props;
---

<section class="py-12">
  <Container>
    <h2>Technology solutions for the real world</h2>
    <HorizontalBar />

    <p class="mt-4 md:max-w-prose">
      From computer repairs to complete security and networking installations,
      we provide practical technology solutions for homes, businesses and
      institutions.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        services.map((service) => (
          <div class="bg-white p-4 shadow">
            <h3 class="capitalize text-xl">{service.data.title}</h3>

            <div class="mt-4 h-40">
              <Image
                src={service.data.image}
                alt={service.data.title}
                class="w-full h-full object-cover"
              />
            </div>

            <div class="mt-6 flex flex-col gap-8">
              <p>{service.data.description}</p>

              <a
                href={`/services/${service.id}`}
                class="mt-auto border px-6 py-2 hover:bg-black hover:text-white transition-all duration-300 w-fit flex items-center gap-2"
              >
                Learn more <ArrowRight />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
