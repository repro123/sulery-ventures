---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";

import FAQ from "@components/client/FAQ.tsx";

import SlugHero from "@components/slug/SlugHero.astro";
import SlugIntro from "@/components/slug/SlugIntro.astro";
import SlugService from "@/components/slug/SlugService.astro";
import SlugServiceForClient from "@/components/slug/SlugServiceForClient.astro";
import SlugSetupProcess from "@/components/slug/SlugSetupProcess.astro";
---

<script define:vars={{ service }}>
  console.log(service);
</script>

<Layout
  title={`${service.data.title} | Sulery Ventures | Technology & Security Solutions in Lagos`}
  description={service.data.description}
>
  <Main>
    <SlugHero service={service} />

    <SlugIntro
      heading={service.data.introHeading}
      paragraphs={service.data.intro}
    />

    <SlugService
      heading={service.data.subserviceHeading}
      subservices={service.data.subservices}
    />

    <SlugServiceForClient
      heading={service.data.clientSection?.heading ?? "Our clients"}
      cards={service.data.clientSection?.cards ?? []}
    />

    <SlugSetupProcess processes={service.data.setupProcesses} />

    <section>
      <Content />
    </section>

    <FAQ items={service.data.faqs} client:load />
  </Main>
</Layout>

<style>
  .prose {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .prose :global(h2) {
    margin-top: 4rem;
    margin-bottom: 1.25rem;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-primary-orange);
  }

  .prose :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 650;
    color: var(--color-primary-orange);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .prose :global(ul) {
    margin: 1rem 0 2rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .prose :global(strong) {
    color: var(--color-main-text);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .prose {
      padding: 3.5rem 1.25rem;
    }

    .prose :global(h2) {
      font-size: 1.65rem;
    }

    .prose :global(h3) {
      font-size: 1.2rem;
    }
  }
</style>
