---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";

import ServiceOverviewHero from "@components/services/ServiceOverviewHero.astro";
import WhatWeDo from "@components/services/WhatWeDo.astro";

import ServicesListSchema from "@components/seo/ServicesListSchema.astro";

import { getCollection } from "astro:content";

const services = await getCollection("services");

const sortedServices = services.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Sulery Ventures Services | Technology & Security Solutions in Lagos"
  description="Sulery Ventures provides computer sales and repairs, CCTV installation, networking, access control, intercom systems and technology solutions for homes, businesses and institutions in Lagos."
>
  <Main>
    <ServicesListSchema services={sortedServices} />
    <ServiceOverviewHero />
    <WhatWeDo services={sortedServices} />
  </Main>
</Layout>
