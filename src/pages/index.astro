---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";

import HeroSection from "@components/home/HeroSection.astro";
import ScrollingServices from "@components/home/ScrollingServices.astro";
import Services from "@components/home/Services.astro";
import ProfessionalService from "@components/home/ProfessionalService.astro";
import TechnologySolutions from "@components/home/TechnologySolutions.astro";
import ProblemToSolution from "@components/home/ProblemToSolution.astro";

import { getCollection } from "astro:content";

const services = await getCollection("services");

const sortedServices = services.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Sulery Ventures | Technology & Security Solutions in Lagos"
  description="Sulery Ventures provides computer sales and repairs, CCTV installation, networking, access control, intercom systems and technology solutions for homes, businesses and institutions in Lagos."
>
  <Main>
    <HeroSection />
    <ScrollingServices services={sortedServices} />
    <Services services={sortedServices} />
    <ProfessionalService />
    <TechnologySolutions />
    <ProblemToSolution />
  </Main>
</Layout>
